    "link-check": "tsx scripts/check-links.ts",
    "generate:props": "tsx scripts/generate-props.ts"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.3.8",
    "@vkieu/mui": "workspace:*",
    "motion": "^13.5.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@mdx-js/loader": "^3.1.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react-docgen-typescript": "^2.4.0",
    "shiki": "^4.5.0",
    "sirv-cli": "^3.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15"
  }
