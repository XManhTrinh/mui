{
  "name": "site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm generate:props && next dev --webpack",
    "build": "pnpm generate:props && next build --webpack",
    "preview": "sirv out --port 3000",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint --max-warnings 0 . --config ../../eslint.config.js",
